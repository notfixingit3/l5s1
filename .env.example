# Copy to .env if you want compose/env overrides (optional; compose defaults are passkey-safe)

PORT=8080
DATA_DIR=./data
DATABASE_DSN=file:./data/l5s1.db?cache=shared&mode=rwc

# --- WebAuthn: keep stable for the life of a dev machine's passkeys ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:8080
WEBAUTHN_RP_DISPLAY_NAME=L5S1 Health Registry

SEED_ADMIN_EMAIL=admin@l5s1.local
SECURE_COOKIE=false
FRONTEND_DIR=../frontend

# --- Local dev only ---
# ALLOW_SIGNUPS: let zero-credential shells (seeded admin, pre-created
# accounts) be claimed via Create account. Default false; hosted instances
# enable it only briefly to bind the admin passkey. New accounts always
# need an invite regardless of this flag.
ALLOW_SIGNUPS=true
# SEED_DEMO_ACCOUNTS: seed the tom/jess demo accounts. Default false; never
# enable on a hosted instance.
SEED_DEMO_ACCOUNTS=true
